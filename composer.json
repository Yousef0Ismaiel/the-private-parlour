{
    "name": "parlour/private-parlour",
    "type": "project",
    "description": "An invitation-only Laravel landing page.",
    "require": {
        "php": "^8.3",
        "ext-pdo_sqlite": "*",
        "ext-xmlwriter": "*",
        "bacon/bacon-qr-code": "^3.0",
        "laravel/framework": "^13.0",
        "pragmarx/google2fa": "^9.0"
    },
    "require-dev": { "phpunit/phpunit": "^12.5", "mockery/mockery": "^1.6" },
    "autoload": { "psr-4": { "App\\": "app/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
    },
    "config": { "sort-packages": true, "optimize-autoloader": true, "platform": { "php": "8.3.0" } },
    "minimum-stability": "stable",
    "prefer-stable": true
}
